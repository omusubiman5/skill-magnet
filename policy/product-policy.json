{
  "schema_version": 1,
  "policy_id": "github-source-of-truth-v1",
  "status": "approved",
  "principles_ja": [
    "GitHubのユーザー所有保管庫を唯一の正本とする。",
    "Skill Magnetはスキルの目的に沿って、必要なパックだけを明示選択して呼び出す。",
    "Codex/Claudeへの全件・常設・暗黙同期を既定にしない。",
    "一時ローカル展開が技術的に必要な場合も、対象・理由・期限・cleanupを明示し、検証後に片付ける。",
    "保管庫の版・来歴・承認を保持する。",
    "ローカル配置の成功を、スキルの読み込み成功または使用成功とみなさない。",
    "選択したpackとversionをタスクへ明示し、読み込み証拠とスキル固有の適用証拠を検証する。",
    "公式に確認できる経路または必要な証拠がない場合はfail-closedで停止し、保証外であることを明示する。",
    "起動はユーザーの右クリックメニューからの明示選択を条件とし、自動提案・自動配布・自動有効化をしない。",
    "Windows ExplorerとmacOS Finderで同じ選択・確認・起動の意味と安全ポリシーを提供する。"
  ],
  "source_of_truth": {
    "kind": "user_owned_github_repository",
    "sole": true,
    "required_identity": ["repository_url", "commit_sha"]
  },
  "activation": {
    "trigger": "manual_user_selection_in_application",
    "default_active_packs": 0,
    "selection": "explicit_single_pack",
    "runtime_selection": "explicit",
    "prohibited_defaults": [
      "all_packs",
      "persistent_install",
      "implicit_sync",
      "automatic_suggestion",
      "automatic_distribution",
      "automatic_activation",
      "local_placement_as_activation",
      "unverified_skill_use"
    ]
  },
  "temporary_materialization": {
    "allowed_only_when_runtime_requires": true,
    "required_fields": ["target", "reason", "expires_at", "cleanup_plan"],
    "cleanup_trigger": "after_runtime_verification_or_expiry",
    "required_final_state": "no_residue"
  },
  "provenance": {
    "required": true,
    "required_fields": ["repository_url", "commit_sha", "approved_by", "approved_at"]
  },
  "product_scope": {
    "deliverables": [
      "skill_magnet_application",
      "separate_user_owned_skill_repository"
    ],
    "objective": "select_an_exact_repository_version_and_obtain_evidence_that_target_codex_read_and_applied_it"
  },
  "launch_ui": {
    "entrypoint": "operating_system_context_menu",
    "required_flow": [
      "open_context_menu",
      "choose_skill_magnet",
      "explicitly_select_pack",
      "confirm_target_version_and_purpose",
      "launch"
    ],
    "automatic_execution": false,
    "supported_platforms": ["windows_explorer", "macos_finder"],
    "platform_menu_visual_parity_required": false,
    "semantic_and_safety_parity_required": true,
    "architecture": {
      "shared_core": [
        "repository",
        "selection",
        "verification",
        "launch_contract"
      ],
      "platform_adapters": [
        "windows_explorer_context_menu",
        "macos_finder_context_menu"
      ]
    }
  },
  "skill_use_verification": {
    "success_requires_all": [
      "task_delivery_evidence",
      "skill_read_evidence",
      "skill_specific_application_evidence"
    ],
    "placement_is_not_evidence_of": ["skill_read", "skill_application"],
    "self_report_alone_is_sufficient": false,
    "missing_evidence_result": "fail_closed",
    "unsupported_guarantee_label": "not_guaranteed"
  },
  "codex": {
    "default_route": "explicit_task_injection",
    "inject_required": [
      "pack_id",
      "repository_url",
      "commit_sha",
      "skill_ids",
      "instruction_digest"
    ],
    "temporary_native_skill_placement_default": false,
    "session_only_native_skill_addition_officially_confirmed": false
  },
  "completion": {
    "requires_end_to_end_automated_test": true,
    "test_must_use_both_deliverables": true,
    "local_placement_only_is_complete": false,
    "requires_all_supported_platform_adapters": true,
    "single_platform_is_complete": false
  },
  "legacy_persistent_sync": {
    "default_enabled": false,
    "production_use": "prohibited_until_redesign_is_approved_and_implemented"
  }
}
